# ═══════════════════════════════════════════════════════════════════════════════
# VEL TRADING PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
# 1. Copy this file to .env.production
# 2. Fill in all required values
# 3. Store sensitive values in AWS Secrets Manager
# 4. Never commit .env.production to version control
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# AWS CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=<your-aws-account-id>

# EKS Cluster
VEL_EKS_CLUSTER=vel-prod
VEL_EKS_NAMESPACE=vel-system

# ECR Repository
ECR_REPOSITORY=vel-trading
IMAGE_TAG=latest

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
ANVEL_ENVIRONMENT=production
ANVEL_DEBUG=false
ANVEL_LOG_LEVEL=INFO

# Web Server
ANVEL_WEB_PASSWORD=<strong-password-from-secrets-manager>
FLASK_SECRET_KEY=<random-secret-key>
FLASK_ENV=production

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION (RDS PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────
ANVEL_DATABASE_URL=postgresql://veladmin:<password>@vel-db.cluster-xxxxx.us-east-1.rds.amazonaws.com:5432/veltrading
POSTGRES_HOST=vel-db.cluster-xxxxx.us-east-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=veltrading
POSTGRES_USER=veladmin
POSTGRES_PASSWORD=<from-secrets-manager>

# ─────────────────────────────────────────────────────────────────────────────
# CACHE CONFIGURATION (ElastiCache Redis)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_HOST=vel-redis.xxxxx.ng.0001.use1.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=<from-secrets-manager>
REDIS_TLS=true

# ─────────────────────────────────────────────────────────────────────────────
# BLOCKCHAIN / WEB3 CONFIGURATION (DEX ONLY - NO CEX)
# ─────────────────────────────────────────────────────────────────────────────
# CRITICAL: Store private key in AWS Secrets Manager, not here!
ANVEL_WALLET_PRIVATE_KEY=<from-secrets-manager:vel/wallet/private-key>

# RPC Endpoints (use paid providers for production)
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<api-key>
BSC_RPC_URL=https://bsc-dataseed.binance.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
POLYGON_RPC_URL=https://polygon-rpc.com
BASE_RPC_URL=https://mainnet.base.org

# ─────────────────────────────────────────────────────────────────────────────
# TRADING CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
TRADING_ENABLED=false
TRADING_DRY_RUN=true
MAX_TRADE_SIZE_USD=1000
MAX_SLIPPAGE_PERCENT=0.5
DEFAULT_GAS_LIMIT=300000

# ─────────────────────────────────────────────────────────────────────────────
# MONITORING & OBSERVABILITY
# ─────────────────────────────────────────────────────────────────────────────
PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_METRICS_PORT=9090
CLOUDWATCH_ENABLED=true
CLOUDWATCH_LOG_GROUP=/vel/production

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://vel.kessann.bot
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ─────────────────────────────────────────────────────────────────────────────
# ETERNAL LEARNING ENGINE
# ─────────────────────────────────────────────────────────────────────────────
ANVEL_MODEL_BUCKET=vel-ml-models-prod
EFS_MOUNT_POINT=/mnt/efs/vel

# ═══════════════════════════════════════════════════════════════════════════════
# END OF CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
