# ANVEL Environment Variables Template
# Copy to .env and fill in values
# NEVER commit .env to version control

# ===========================================
# SYSTEM SETTINGS
# ===========================================
ANVEL_ENVIRONMENT=development
ANVEL_LOG_LEVEL=INFO
ANVEL_DATA_DIR=data

# ===========================================
# TRADING SETTINGS
# ===========================================
ANVEL_TRADING_ENABLED=false
ANVEL_TRADING_DRY_RUN=true
ANVEL_TRADING_CONFIRMED=false

# ===========================================
# EXCHANGE API CREDENTIALS (CEX REMOVED)
# ===========================================
# VEL is DEX-only. CEX API keys are no longer supported.
# Price discovery uses on-chain data from DEX pools or oracles.

# ===========================================
# BLOCKCHAIN RPC ENDPOINTS
# ===========================================
ANVEL_ETHEREUM_RPC_URL=https://eth.llamarpc.com
ANVEL_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ANVEL_POLYGON_RPC_URL=https://polygon-rpc.com

# ===========================================
# WALLET (KEEP SECURE)
# ===========================================
ANVEL_WALLET_PRIVATE_KEY=

# ===========================================
# DATABASE
# ===========================================
ANVEL_DATABASE_URL=sqlite:///data/anvel.db

# ===========================================
# AWS (Optional)
# ===========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
